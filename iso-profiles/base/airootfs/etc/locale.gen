# Vaşak Linux locale configuration
# Uncomment the locales you need

# English (US)
en_US.UTF-8 UTF-8
en_US ISO-8859-1

# Turkish (for Pardus refugees!)
tr_TR.UTF-8 UTF-8
tr_TR ISO-8859-9

# German
de_DE.UTF-8 UTF-8
de_DE ISO-8859-1
de_DE@euro ISO-8859-15

# French
fr_FR.UTF-8 UTF-8
fr_FR ISO-8859-1
fr_FR@euro ISO-8859-15

# Spanish
es_ES.UTF-8 UTF-8
es_ES ISO-8859-1
es_ES@euro ISO-8859-15

# Japanese
ja_JP.UTF-8 UTF-8

# Chinese (Simplified)
zh_CN.UTF-8 UTF-8
zh_CN GB2312
zh_CN.GB18030 GB18030

# Chinese (Traditional)
zh_TW.UTF-8 UTF-8
zh_TW BIG5