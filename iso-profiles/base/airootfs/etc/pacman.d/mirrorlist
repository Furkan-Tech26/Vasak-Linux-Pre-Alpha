# Vaşak Linux mirrorlist - Turkey-first (low latency for Anatolia)
# Generated by vasak-mirrorlist package
# Run `reflector --country Turkey,Germany,Netherlands,France --age 12 --protocol https --sort rate --save /etc/pacman.d/mirrorlist` to refresh

# Turkey (fastest for you)
Server = https://mirror.veriteknik.net.tr/archlinux/$repo/os/$arch
Server = https://archlinux.mirror.uber.net.tr/$repo/os/$arch
Server = https://mirror.netcologne.de/archlinux/$repo/os/$arch

# Germany (excellent connectivity to Turkey)
Server = https://mirror.23media.com/archlinux/$repo/os/$arch
Server = https://mirror.metalgamer.eu/archlinux/$repo/os/$arch
Server = https://archlinux.thaller.ws/$repo/os/$arch

# Netherlands
Server = https://mirror.koddos.net/archlinux/$repo/os/$arch
Server = https://mirror.i3d.net/pub/archlinux/$repo/os/$arch

# France
Server = https://archlinux.mirrors.ovh.net/archlinux/$repo/os/$arch
Server = https://mirror.oldsql.cc/archlinux/$repo/os/$arch

# Global CDN fallback
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch