<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="1920" height="1080">
  <!-- Vaşak Linux systemd-boot splash - Glassmorphism -->
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1E1E2E;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#282A36;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#181825;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="centerGlow" cx="50%" cy="40%" r="40%">
      <stop offset="0%" style="stop-color:#88C0D0;stop-opacity:0.08" />
      <stop offset="100%" style="stop-color:#1E1E2E;stop-opacity:0" />
    </radialGradient>
  </defs>

  <rect width="1920" height="1080" fill="url(#bgGrad)"/>
  <ellipse cx="960" cy="432" rx="700" ry="400" fill="url(#centerGlow)"/>

  <!-- Badge -->
  <g transform="translate(960, 300) scale(2.5)">
    <circle cx="0" cy="0" r="60" fill="#282A36" stroke="#88C0D0" stroke-width="2"/>
    <g fill="#88C0D0">
      <ellipse cx="0" cy="15" rx="21" ry="15"/>
      <ellipse cx="27" cy="-5" rx="12" ry="11"/>
      <ellipse cx="37" cy="-5" rx="7" ry="5"/>
      <circle cx="30" cy="-8" r="2" fill="#1E1E2E"/>
      <path d="M21,-12 Q22,-21 30,-12" fill="none" stroke="#88C0D0" stroke-width="2" stroke-linecap="round"/>
      <path d="M19,0 Q22,-5 33,0" fill="none" stroke="#ECEFF4" stroke-width="3" stroke-linecap="round"/>
      <path d="M19,10 Q22,15 33,10" fill="none" stroke="#ECEFF4" stroke-width="3" stroke-linecap="round"/>
      <rect x="-12" y="21" width="4" height="15" rx="2"/>
      <rect x="-5" y="21" width="4" height="15" rx="2"/>
      <rect x="15" y="21" width="4" height="15" rx="2"/>
      <rect x="22" y="21" width="4" height="15" rx="2"/>
      <path d="M-17,15 Q-24,12 -27,17" fill="none" stroke="#88C0D0" stroke-width="4" stroke-linecap="round"/>
    </g>
  </g>

  <text x="960" y="580" font-family="sans-serif" font-size="32" font-weight="300" fill="#ECEFF4" text-anchor="middle" letter-spacing="4">VAŞAK LINUX</text>
  <text x="960" y="620" font-family="sans-serif" font-size="16" fill="#88C0D0" text-anchor="middle">Badger doesn't care. Badger boots.</text>

  <!-- Menu area indicator -->
  <rect x="480" y="700" width="960" height="200" rx="16" fill="#282A36" fill-opacity="0.8" stroke="#88C0D0" stroke-width="1.5" stroke-opacity="0.3"/>
  <text x="960" y="820" font-family="sans-serif" font-size="14" fill="#6272A4" text-anchor="middle">Use ↑/↓ to select, Enter to boot, e to edit</text>
</svg>