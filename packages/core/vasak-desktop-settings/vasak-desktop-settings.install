post_install() {
    # Brand LightDM. The files live in /usr/share/vasak so this package never
    # ships a path owned by lightdm / lightdm-gtk-greeter (pacman treats
    # duplicate files between target packages as a fatal conflict).
    install -dm755 /etc/lightdm
    install -m644 /usr/share/vasak/lightdm/lightdm.conf /etc/lightdm/lightdm.conf
    install -m644 /usr/share/vasak/lightdm/lightdm-gtk-greeter.conf /etc/lightdm/lightdm-gtk-greeter.conf

    # Update XFCE settings database
    xdg-desktop-menu forceupdate 2>/dev/null || true
    update-desktop-database 2>/dev/null || true
}

post_upgrade() {
    post_install
}
